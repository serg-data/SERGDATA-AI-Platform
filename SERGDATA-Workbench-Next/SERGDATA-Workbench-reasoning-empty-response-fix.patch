--- a/workbench/tool_call_adapter.py
+++ b/workbench/tool_call_adapter.py
@@ -114,3 +114,29 @@
     if native:
         return list(native), False, None
     return parse_text_tool_calls(getattr(message, "content", "") or "", tools)
+
+
+def visible_response_text(message, fallback=""):
+    """Return only user-visible assistant content, never private reasoning.
+
+    Some local OpenAI-compatible servers can finish with an empty `content`
+    while populating `reasoning_content`. Reasoning is deliberately NOT used
+    as a substitute: callers receive an explicit, safe fallback instead.
+    """
+    content = getattr(message, "content", None)
+    if isinstance(content, str) and content.strip():
+        return content
+    return fallback
+
+
+def empty_response_notice(message, stage="ответа"):
+    """Explain an empty visible response without exposing reasoning tokens."""
+    reasoning = getattr(message, "reasoning_content", None)
+    if isinstance(reasoning, str) and reasoning.strip():
+        return (
+            f"Модель завершила генерацию, но не вернула пользовательский текст ({stage}). "
+            "Текст присутствует только во внутреннем поле reasoning_content и не был "
+            "показан во избежание раскрытия внутренних рассуждений. Повтори запрос "
+            "или проверь формат ответа/шаблон модели в LM Studio."
+        )
+    return f"Модель завершила генерацию без пользовательского текста ({stage}). Повтори запрос."
--- a/tests/test_tool_call_adapter.py
+++ b/tests/test_tool_call_adapter.py
@@ -143,3 +143,26 @@
     calls, detected, error = parse_text_tool_calls('<tool_call><function=sandbox_run_check>', _tools())
     assert detected and not calls
     assert 'незавершённый' in error
+
+
+def test_reasoning_content_is_never_used_as_user_visible_answer():
+    from workbench.tool_call_adapter import visible_response_text, empty_response_notice
+    message = SimpleNamespace(content='', reasoning_content='Внутренний текст с возможными рассуждениями', tool_calls=None)
+    assert visible_response_text(message, '') == ''
+    notice = empty_response_notice(message, 'основного ответа')
+    assert 'reasoning_content' in notice
+    assert 'Внутренний текст' not in notice
+    assert 'не был показан' in notice
+
+
+def test_regular_content_wins_even_when_reasoning_is_present():
+    from workbench.tool_call_adapter import visible_response_text
+    message = SimpleNamespace(content='Готово.', reasoning_content='private reasoning')
+    assert visible_response_text(message, 'fallback') == 'Готово.'
+
+
+def test_empty_response_without_reasoning_gets_clear_notice():
+    from workbench.tool_call_adapter import empty_response_notice
+    message = SimpleNamespace(content='', reasoning_content=None)
+    notice = empty_response_notice(message, 'основного ответа')
+    assert 'без пользовательского текста' in notice
