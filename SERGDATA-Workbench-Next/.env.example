# SERGDATA Workbench — переносимый пример настроек.
# Скопируй этот файл в .env и укажи реальные пути к своему Knowledge MCP и проекту.
LM_BASE_URL=http://127.0.0.1:1234/v1
LM_API_KEY=lm-studio
LM_MODEL=local-model

# Оставь false, пока не настроишь пути ниже.
KB_ENABLED=false
KB_SERVER=./knowledge/server.py
KB_CWD=.
KB_PYTHON=python
PROJECT_ROOT=.

CONTEXT_LIMIT=50000
MAX_TOOL_ROUNDS=16
HOST=127.0.0.1
PORT=8787
